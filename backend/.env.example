# Kopiere diese Datei nach .env und passe die Werte an.
# (settings.py lädt backend/.env und ../.env; Docker-Compose setzt die Werte direkt.)

# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Datenbank
POSTGRES_DB=verkehrsmedizin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin-Bereich & GDT-Bridge (Pflicht, sonst liefern /api/admin/* und /api/gdt/* 403)
# Key erzeugen z.B. mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=

# Basis-URL des Frontends (für Einladungs-Links in E-Mails)
APP_URL=http://localhost:3000

# Gültigkeitsdauer der Fragebogen-Links in Tagen
SESSION_VALIDITY_DAYS=14

# E-Mail (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
