# GDT Bridge – Konfigurationsdatei
# Kopiere diese Datei zu config.ini und passe die Werte an.
# Kommentare beginnen mit #

[bridge]

# ── GDT-Ordner (lokal auf diesem Rechner) ──────────────────────────────────
# SAMAS schreibt Anforderungs-GDT hierher
gdt_inbox  = C:\GDT\inbox

# Ergebnis-GDT-Dateien werden hierher geschrieben (SAMAS liest sie)
gdt_outbox = C:\GDT\outbox

# ── Django Server ───────────────────────────────────────────────────────────
# Basis-URL des API (ohne abschließenden Slash)
api_url = https://dein-server.de/api

# Admin API Key (ADMIN_API_KEY in der .env des Servers)
api_key = DEIN-GEHEIMER-API-KEY

# Welche Untersuchungsart (Fragebogen-Template) soll verwendet werden?
# Leer lassen = Verkehrsmedizin ("verkehrsmedizin-leitlinien").
# Weitere Kataloge (Auswahl): laerm-2024, g20-laerm-2016, haut-2024,
# atemschutz-2024, hitze-2024, kaelte-2024, ausland-2024, bildschirm-2024,
# absturz-2024, infektion-2024, muskel_skelett-2024 … (vollständige Liste:
# GET /api/admin/templates/)
template_slug =

# ── GDT-Encoding ────────────────────────────────────────────────────────────
# Zeichensatz der GDT-Dateien (wird zum Lesen UND Schreiben verwendet).
# Der GDT-Standard schreibt eigentlich cp437 (IBM PC-Zeichensatz) vor,
# viele Praxissysteme schreiben aber cp1252 (Windows-1252).
# Bei Umlaut-Problemen (z.B. "M„ller" statt "Müller") auf cp437 umstellen.
gdt_encoding = cp1252

# ── Polling-Intervalle ──────────────────────────────────────────────────────
# Wie oft (Sekunden) wird der Eingangsordner auf neue .gdt-Dateien geprüft?
poll_inbox_seconds = 5

# Wie oft (Sekunden) wird geprüft ob ein Fragebogen ausgefüllt wurde?
poll_result_seconds = 30
