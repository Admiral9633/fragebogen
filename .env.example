# Kopiere diese Datei nach .env und passe die Werte an.
# Docker Compose liest diese Datei automatisch; settings.py laedt sie zusaetzlich
# fuer lokale Laeufe ohne Docker.
# WICHTIG: Die echte .env darf NIE committet werden (steht in .gitignore).

# ── Django ───────────────────────────────────────────────────────────────────
# Erzeugen z.B. mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
DEBUG=False

# Hosts/Origins, unter denen die App erreichbar ist (Komma-getrennt).
# Beispiel fuer den Praxis-Server: localhost,127.0.0.1,backend,192.168.178.84
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Datenbank ────────────────────────────────────────────────────────────────
POSTGRES_DB=verkehrsmedizin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── Admin-Bereich & GDT-Bridge ───────────────────────────────────────────────
# Gleicher Wert wie api_key in gdt_bridge/config.ini!
# Erzeugen z.B. mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=

# Basis-URL des Frontends (steht in den Einladungs-Mails an Patienten)
APP_URL=http://localhost:3000

# Gueltigkeitsdauer der Fragebogen-Links in Tagen
SESSION_VALIDITY_DAYS=14

# ── E-Mail (SMTP) ────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.web.de
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
