# Kopiere diese Datei nach .env.local und passe die Werte an.

# Basis-URL des Django-Backends (serverseitig genutzt: Rewrites, Print-Page, PDF-Route)
# Im Docker-Compose-Setup: http://backend:8000 — lokal: http://localhost:8000
BACKEND_URL=http://localhost:8000

# URL, unter der die Next.js-App selbst erreichbar ist (Puppeteer rendert darüber die Print-Page).
# Im Container: http://localhost:3000 (Puppeteer läuft im selben Container)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pfad zum Chrome/Chromium-Binary für die PDF-Route.
# Im Prod-Image vorinstalliert (/usr/bin/chromium-browser); für lokales Dev unter Windows z.B.:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
